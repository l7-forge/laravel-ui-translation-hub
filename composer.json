{
    "name": "l7labs/laravel-ui-translation-hub",
    "description": "Automated UI localization manager for Laravel with a clean Livewire dashboard and automated JSON syncing.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "viking74",
            "email": "deine-email@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0|^4.0",
        "livewire/volt": "^1.0|^2.0"
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=ui-translation-styles --force || true",
            "@php artisan vendor:publish --tag=ui-translation-hub-config --skip-if-exists || true",
            "@php artisan vendor:publish --tag=ui-language-switcher --skip-if-exists || true"
        ]
    },
    "autoload": {
        "psr-4": {
            "l7Labs\\LaravelUiTranslationHub\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "L7Labs\\LaravelUiTranslationHub\\Providers\\LaravelUiTranslationHubServiceProvider"
            ]
        }
    }
}