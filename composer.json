{
    "name": "l7-forge/laravel-ui-translation-hub",
    "type": "library",
    "description": "Translation Hub UI package for Laravel",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "L7Labs\\LaravelUiTranslationHub\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "L7Labs\\LaravelUiTranslationHub\\Providers\\LaravelUiTranslationHubServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}